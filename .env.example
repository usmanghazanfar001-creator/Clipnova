# --- Core ---
DATABASE_URL="postgresql://clipnova:clipnova@localhost:5432/clipnova"
REDIS_URL="redis://localhost:6379"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# --- Google OAuth (optional; button appears only when both are set) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Groq ---
GROQ_API_KEY=""
# whisper-large-v3-turbo (default) or whisper-large-v3
WHISPER_MODEL="whisper-large-v3-turbo"
GROQ_LLM_MODEL="llama-3.3-70b-versatile"

# --- Limits ---
MAX_UPLOAD_MB="500"
MAX_VIDEO_MINUTES="30"
DEFAULT_CREDITS="10"
# Rendered MP4s stay downloadable (and on disk) for this many days.
RENDER_RETENTION_DAYS="7"

# --- Storage (local disk driver for now) ---
STORAGE_DIR="./storage"

# --- Email ---
# When RESEND_API_KEY is empty, emails are printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Clipnova <no-reply@example.com>"
# Set to "false" in local dev to skip email verification.
REQUIRE_EMAIL_VERIFICATION="true"
